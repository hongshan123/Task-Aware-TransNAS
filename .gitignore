# Keep empty project directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/replay/.gitkeep
!artifacts/checkpoints/.gitkeep
!artifacts/nas_runs/.gitkeep
!logs/.gitkeep

# Keep bounded Phase 6B aggregate outputs with the reports; raw runs and checkpoints stay local.
!results/
results/*
!results/phase6b/
results/phase6b/*
!results/phase6b/compatibility_matrices.csv
!results/phase6b/gpu_smoke.json
!results/phase6b/pilot_summary.json
!results/phase6b/pilot_task_metrics.csv
!results/phase6b/pilot_resource_summary.csv
!results/phase6b/task_similarity_gradient_matrix.csv
!results/phase6b/compatibility_manifest.json

# Phase 7A compact evidence; checkpoints, component dumps, and step audits stay local.
!results/phase7a/
results/phase7a/*
!results/phase7a/phase7a_config.json
!results/phase7a/pilot_stage_summary.csv
!results/phase7a/pilot_final_task_metrics.csv
!results/phase7a/functional_importance_preservation_correlations.csv
!results/phase7a/functional_importance_rollback_controls.csv
!results/phase7a/functional_importance_preservation_summary.json
!results/phase7a/S1/
!results/phase7a/S2/
